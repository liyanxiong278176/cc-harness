{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the local cc-harness desktop client",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "args": [
            "--cwd",
            {
              "validator": ".+"
            }
          ],
          "name": "binaries/cc-harness-desktop-bridge",
          "sidecar": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "updater:default",
    "process:allow-restart"
  ]
}
