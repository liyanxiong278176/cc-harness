# ============ campus-delivery 本地/容器化运行配置 ============
# 复制为 .env 后按需修改;docker compose 会自动读取 .env

# ---- 安全密钥(生产必须注入 ≥32 字节随机值) ----
# JWT 签名密钥(≥32 字节)。示例值仅供本地开发。
APP_JWT_SECRET=dev-only-jwt-secret-please-change-0123456789
# AES 加密密钥(Base64, 16 或 32 字节;用于手机号等敏感字段)
APP_CRYPTO_KEY=MTIzNDU2Nzg5MDEyMzQ1Ng==

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_PASSWORD=campus123456

# ---- RabbitMQ ----
RABBITMQ_USER=campus
RABBITMQ_PASSWORD=campus123456

# ---- 特性开关 ----
# APP_MQ_ENABLED=true            # 是否启用 MQ 消费(通知/事件)
# APP_SEED_DEMO_PASSWORD_RESET=true  # 启动时重置演示账号密码为 123456

# ---- 模拟外部适配器(可替换为真实实现) ----
# app.adapter.payment.mock=true
# app.adapter.sms.mock=true
# app.adapter.dispatch.mock=true
