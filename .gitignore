# L4 policy gate audit log (M1) — agent writes decisions here each run.
# Scope to this file only; logs/ also holds the tracked logs/mcp_server.log.
/logs/policy.jsonl

# Q4 offload refs — may contain raw tool output (cat .env etc.), L5-exempt at rest.
# keep local; never commit.
/logs/memory/refs/

# locomo dataset (大,不入仓)
eval/locomo/data/locomo10.json
eval/locomo/.checkpoint.json

# M5-2 judge cache (locomo runner writes under output_dir / ".judge-cache")
eval/result/.judge-cache/
# cc-harness:exclude per-task markdown descriptions (live in yaml main index)
.cc-harness/todos/*.md
.cc-harness/sessions.db
.cc-harness/sessions.db-shm
.cc-harness/sessions.db-wal
.cc-harness/session-attachments/
.cc-harness/input-history
# cc-harness:keep directory tracked even when empty

# Local ad-hoc logs / debug dumps (do not commit)
# NOTE: logs/ contains tracked mcp_server.log — do NOT ignore the directory.
/debug.log
/pytestdebug.log
/tmpreg*.log
/logs/locomo-*.log
/logs/locomo_memory.db
/logs/memory.db
/logs/memory/
/logs/memory_maintenance.jsonl
/logs/persona.md
/logs/sandbox.jsonl
/logs/scenarios/
/logs/cross_session.jsonl
/logs/l2.jsonl
/logs/l5.jsonl

# Locomo eval results / dryrun (large jsonl + screenshots — generated each run)
eval/result/_dryrun/
eval/result/conv-*.trace.jsonl
eval/result/locomo-*/
eval/result/locomo-*.json
eval/result/promptfoo-result/
eval/result/parity-*/
/img/

# cc-harness ad-hoc session/test memory DB
cc_harness/memory/*.db

# Local env / wrapper scripts (eval tooling)
/eval/promptfoo/.cc_env.sh
/eval/promptfoo/promptfoo.txt
/eval/img/
.playwright-mcp

# Local benchmark evidence, downloaded datasets, and pinned upstream checkouts.
/eval/result/
/eval/cc_only/data/
/eval/cc_only/upstream/

# Local agent/runtime state and tool caches.
/.cc-harness/
/.codegraph/
/.deepeval/
/.superpowers/brainstorm/
/logs/reflection.jsonl
/logs/*.db-shm
/logs/*.db-wal
