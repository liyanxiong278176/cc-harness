# All three are required — no defaults.
# Examples below; replace with your provider.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Langfuse cloud(可选,无 key 时 trace 自动 graceful disable)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional task budgets: no total limit is imposed unless configured on a task.
# Output bound only applies to calls with token/cost budgets.
# CC_HARNESS_BUDGET_MAX_OUTPUT_TOKENS=8192
# Monetary budgets require user-supplied price upper bounds in the budget's currency.
# CC_HARNESS_BUDGET_INPUT_COST_PER_MILLION=
# CC_HARNESS_BUDGET_OUTPUT_COST_PER_MILLION=
