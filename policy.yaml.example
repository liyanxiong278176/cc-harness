# cc-harness 权限闸门配置(M1,L4)。留空/不创建文件 = 用内置默认。
# 复制为 policy.yaml 放项目根以覆盖。
enabled: true            # L4 权限闸门:false=关闭(等同旧行为,仅 run_command 内部加固)
l2:
  enabled: true          # L2 输入防御:false=关闭(只留 L4)
  heuristic_on: true     # L2 第一道传统预过滤:false=只靠 judge
l5:
  enabled: true          # L5 输出 DLP:false=关闭(只留 L4+L2)
  keys_on: true          # Layer A 密钥正则(零依赖):false=不扫密钥
  pii_on: true           # Layer B Presidio PII(需 pip install -e '.[dlp]'):false=不扫 PII
executor:
  enabled: true            # 兼容字段;false 不会隐式选择宿主执行
  backend: sandbox         # sandbox(默认,fail closed)|native(显式宿主执行)
  sandbox:
      server_host: 127.0.0.1   # 用 127.0.0.1 非 localhost(Windows localhost→IPv6 ::1 连不上)
      server_port: 8000
      server_config_path: null # 复用外部 server 时必须指向其实际 TOML 配置
      require_external_attestation: true
      image: cc-harness-runtime:local
      timeout_s: 120
      cpu: 2
      memory_mb: 2048
      pids_limit: 256
      egress_allow: [api.deepseek.com, api.siliconflow.cn, pypi.org, github.com]
      vault: false           # 默认关闭;仅在凭据代理已配置并验证时显式开启
      vault_credentials: []  # 仅写 {name, env_var};不要在策略中写秘密值
      vault_bindings: []     # {name, credential, hosts, auth_type, schemes, methods, paths}
      fallback_on_error: hard    # 兼容字段;运行时始终 fail closed,不会自动降级宿主执行
